From 8d3226afd633d77ea9a2e66f9c8964a9fa8d1d40 Mon Sep 17 00:00:00 2001
From: Simone Rota <simone.rota16@gmail.com>
Date: Thu, 29 Oct 2026 23:52:22 +0000
Subject: [PATCH 15/18] feat(CFC): support setjmp/longjmp in CFCSS, RASM,
 inter-RASM and RACFED

When a setjmp-like (returns_twice) call returns a second time because of a
longjmp, the run-time signatures have the values they had where longjmp was
called, and the following check reported a signature mismatch. After every
returns_twice call the signatures are set back to the values expected at that
point of the block (inter-RASM also restores the ret signature saved before
the call).
---
 passes/CFCSS.cpp       | 19 +++++++++++++++++++
 passes/RACFED.cpp      | 19 ++++++++++++++++++-
 passes/RASM.cpp        | 28 ++++++++++++++++++++++++++++
 passes/Utils/Utils.cpp |  5 +++++
 passes/Utils/Utils.h   |  6 ++++++
 5 files changed, 76 insertions(+), 1 deletion(-)

diff --git a/passes/CFCSS.cpp b/passes/CFCSS.cpp
index a95ed22..62f382d 100755
--- a/passes/CFCSS.cpp
+++ b/passes/CFCSS.cpp
@@ -326,6 +326,25 @@ PreservedAnalyses CFCSS::run(Module &Md, ModuleAnalysisManager &AM) {
           createCFGVerificationBB(*BB, BBSigs, &NewBBs, *CFGErrBB, G, D, NeighborSigs[BB]);
         }
       }
+
+      // When a setjmp-like call returns a second time (because of a call to
+      // longjmp), G and D have the values they had where longjmp was called:
+      // set them back to the ones expected in the block of the call
+      for (auto &Elem : BBSigs) {
+        BasicBlock *BB = Elem.first;
+        if (BB->getParent() != &Fn) {
+          continue;
+        }
+        for (Instruction &I : *BB) {
+          if (isReturnsTwiceCall(I)) {
+            IRBuilder<> BAfter(I.getNextNode());
+            BAfter.CreateStore(llvm::ConstantInt::get(IntType, Elem.second), G, true);
+            if (NeighborSigs[BB] != -1) {
+              BAfter.CreateStore(llvm::ConstantInt::get(IntType, Elem.second ^ NeighborSigs[BB]), D, true);
+            }
+          }
+        }
+      }
       IRBuilder<> ErrB(CFGErrBB);
       
       assert(!getLinkageName(linkageMap,"SigMismatch_Handler").empty() && "Function SigMismatch_Handler is missing!");
diff --git a/passes/RACFED.cpp b/passes/RACFED.cpp
index 967659c..d74b593 100644
--- a/passes/RACFED.cpp
+++ b/passes/RACFED.cpp
@@ -174,8 +174,20 @@ void RACFED::insertIntraInstructionUpdates(Function &Fn,
     std::vector<Instruction*> OrigInstructions;
     originalInstruction(BB, OrigInstructions);
 
+    // When a setjmp-like call returns a second time (because of a call to
+    // longjmp), the runtime signature has the value it had where longjmp was
+    // called: it is set back to the one expected after the call, i.e. the
+    // signature of the block plus the updates of the previous instructions.
     // 7: if NrInstrBB > 2 then
-    if ( OrigInstructions.size() <= 2 ) continue;
+    if ( OrigInstructions.size() <= 2 ) {
+      for (Instruction *I : OrigInstructions) {
+        if ( isReturnsTwiceCall(*I) ) {
+          IRBuilder<> RestoreIR(I->getNextNode());
+          RestoreIR.CreateStore(ConstantInt::get(IntType, compileTimeSig[&BB]), RuntimeSigGV);
+        }
+      }
+      continue;
+    }
 
     uint64_t partial_sum = 0;
 
@@ -189,6 +201,11 @@ void RACFED::insertIntraInstructionUpdates(Function &Fn,
         InsertPt = I->getNextNode(); // insert BEFORE next instruction (equivalent to "after I")
       }
 
+      if ( isReturnsTwiceCall(*I) ) {
+        IRBuilder<> RestoreIR(InsertPt);
+        RestoreIR.CreateStore(ConstantInt::get(IntType, compileTimeSig[&BB] + partial_sum), RuntimeSigGV);
+      }
+
       IRBuilder<> InstrIR(InsertPt);
 
       // 9: signature ← signature + random number
diff --git a/passes/RASM.cpp b/passes/RASM.cpp
index 16db791..bb2db3d 100644
--- a/passes/RASM.cpp
+++ b/passes/RASM.cpp
@@ -451,6 +451,34 @@ PreservedAnalyses RASM::run(Module &Md, ModuleAnalysisManager &AM) {
             createCFGVerificationBB(*BB, RandomNumberBBs, SubRanPrevVals, *RuntimeSig, *RetSig, *ErrBB);
           }
         }
+
+        // When a setjmp-like call returns a second time (because of a call to
+        // longjmp), the runtime signature has the value it had where longjmp
+        // was called: set it back to the one expected in the block of the call
+        for (auto &Elem : RandomNumberBBs) {
+          BasicBlock *BB = Elem.first;
+          if (BB->getParent() != &Fn) {
+            continue;
+          }
+          std::vector<Instruction *> Calls;
+          for (Instruction &I : *BB) {
+            if (isReturnsTwiceCall(I)) {
+              Calls.push_back(&I);
+            }
+          }
+          for (Instruction *Call : Calls) {
+            IRBuilder<> BAfter(Call->getNextNode());
+            #if (INTER_FUNCTION_CFC == 1)
+              // the ret signature is saved before the call and restored after it
+              IRBuilder<> BEntry(&*Fn.front().getFirstInsertionPt());
+              Value *SavedRetSig = BEntry.CreateAlloca(IntType);
+              IRBuilder<> BBefore(Call);
+              BBefore.CreateStore(BBefore.CreateLoad(IntType, RetSig, true), SavedRetSig, true);
+              BAfter.CreateStore(BAfter.CreateLoad(IntType, SavedRetSig, true), RetSig, true);
+            #endif
+            BAfter.CreateStore(llvm::ConstantInt::get(IntType, Elem.second), RuntimeSig, true);
+          }
+        }
       }
     }
 
diff --git a/passes/Utils/Utils.cpp b/passes/Utils/Utils.cpp
index 581b0bb..573265f 100644
--- a/passes/Utils/Utils.cpp
+++ b/passes/Utils/Utils.cpp
@@ -359,3 +359,8 @@ void createFtFuncs(Module &Md) {
     createProfilingFunc(Md, "aspis.datacheck.end", ProfilingType::ConsistencyCheck);
   }
 }
+
+bool isReturnsTwiceCall(const Instruction &I) {
+  const auto *CB = dyn_cast<CallBase>(&I);
+  return CB != nullptr && CB->hasFnAttr(Attribute::ReturnsTwice);
+}
diff --git a/passes/Utils/Utils.h b/passes/Utils/Utils.h
index cdc7f0b..0d9a626 100644
--- a/passes/Utils/Utils.h
+++ b/passes/Utils/Utils.h
@@ -50,4 +50,10 @@ bool isToExcludeName(StringRef FnMangledName);
 
 void createFtFuncs(Module &Md);
 
+// Returns true if I calls a function that can return more than once, like
+// setjmp: when longjmp is called it returns again, from a point of the program
+// where the run-time signatures of the control-flow checking passes have
+// different values.
+bool isReturnsTwiceCall(const Instruction &I);
+
 #endif
\ No newline at end of file
