From fe289be7657c7824389ffa0f829822bee9608ff0 Mon Sep 17 00:00:00 2001
From: Simone Rota <simone.rota16@gmail.com>
Date: Fri, 30 Oct 2026 01:29:01 +0000
Subject: [PATCH 17/19] fix(RASM, RACFED): check the signature in the
 verification blocks of EDDI

RASM and RACFED reset the runtime signature, without checking it, in every
block whose name contains "verification". The condition was meant for the
blocks created by the pass itself, but it also matches the VerificationBB
blocks created by EDDI, which are the successors of most blocks of a
program hardened with EDDI: a wrong branch or jump into one of them
re-synchronised the signature and was not detected.

Found by fault injection: inverting a conditional jump produced no silent
data corruption with RASM or RACFED alone, but 12% of SDCs when they were
combined with EDDI, all at branches whose wrong target was one of those
blocks. Now only landing pads and the blocks created by RASM (RACFED) are
exempted.
---
 passes/RACFED.cpp | 6 +++++-
 passes/RASM.cpp   | 7 ++++++-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/passes/RACFED.cpp b/passes/RACFED.cpp
index d74b593..2e783d2 100644
--- a/passes/RACFED.cpp
+++ b/passes/RACFED.cpp
@@ -238,8 +238,12 @@ void RACFED::checkJumpSignature(BasicBlock &BB,
   // In this case BB is not the first Basic Block of the function, 
   // so it has to update RuntimeSig and check it
   auto FirstNonPHI = BB.getFirstNonPHIIt();
+  // The signature is reset, without checking it, only at the landing pads
+  // (entered while unwinding) and in the blocks created by RACFED itself. The
+  // verification blocks created by EDDI are checked as any other block:
+  // otherwise a wrong branch or jump into one of them is not detected.
   if ( (FirstNonPHI != BB.end() && isa<LandingPadInst>(FirstNonPHI)) ||
-     BB.getName().contains_insensitive("verification") ) {
+     BB.getName().starts_with("RACFED_") ) {
 
     if ( BB.getFirstInsertionPt() == BB.end() ) return; // Skip empty/invalid blocks
 
diff --git a/passes/RASM.cpp b/passes/RASM.cpp
index f61dbba..dcdee73 100644
--- a/passes/RASM.cpp
+++ b/passes/RASM.cpp
@@ -147,7 +147,12 @@ void RASM::createCFGVerificationBB (  BasicBlock &BB,
     int subRanPrevVal = SubRanPrevVals.find(&BB)->second;
     // in this case BB is not the first Basic Block of the function, so it has to update RuntimeSig and check it
     if (!BB.isEntryBlock()) {
-        if (isa<LandingPadInst>(BB.getFirstNonPHI()) || BB.getName().contains_insensitive("verification")) {
+        // The signature is reset, without checking it, only at the landing pads
+        // (entered while unwinding) and in the blocks created by RASM itself.
+        // The verification blocks created by EDDI are checked as any other
+        // block: otherwise a wrong branch or jump into one of them, which are
+        // the successors of most blocks when EDDI is applied, is not detected.
+        if (isa<LandingPadInst>(BB.getFirstNonPHI()) || BB.getName().starts_with("RASM_")) {
           IRBuilder<> BChecker(&*BB.getFirstInsertionPt());
           BChecker.CreateStore(llvm::ConstantInt::get(IntType, randomNumberBB),&RuntimeSig, true);
         }
