     // insert the code for calling the error basic block in case of a mismatch
     CreateErrBB(Md, *Fn, ErrBB);
   }
@@ -2317,6 +2320,35 @@ void EDDI::removeTemporaryDuplicate(Value *Original, Value *Copy) {
   }
 }
 
+// The original and the duplicated copy of a local variable must hold the same
+// value even before the program writes them: the code generated for a
+// bit-field assignment (e.g. h.version = 5) loads the whole word, updates some
+// of its bits and stores it back, so the consistency check on the store would
+// compare the uninitialized, and thus different, bits of the two copies. At
+// the beginning of the function the content of each local variable is copied
+// into its duplicate.
+void EDDI::initDuplicatedAllocas(Function &Fn) {
+  const DataLayout &DL = Fn.getDataLayout();
+  BasicBlock &EntryBB = Fn.getEntryBlock();
+  std::vector<std::pair<AllocaInst *, AllocaInst *>> Pairs;
+  for (Instruction &I : EntryBB) {
+    auto *AI = dyn_cast<AllocaInst>(&I);
+    if (AI != nullptr && AI->isStaticAlloca() && ClonedAllocas.count(AI)) {
+      Pairs.push_back(std::pair(AI, ClonedAllocas[AI]));
+    }
+  }
+  IRBuilder<> B(&*EntryBB.getFirstNonPHIOrDbgOrAlloca());
+  for (auto [Original, Copy] : Pairs) {
+    std::optional<TypeSize> Size = Original->getAllocationSize(DL);
+    if (!Size || Size->isScalable() || Copy->getParent() != &EntryBB) {
+      continue;
+    }
+    Instruction *Init = B.CreateMemCpy(Copy, Copy->getAlign(), Original,
+                                       Original->getAlign(), Size->getFixedValue());
+    DuplicatedInstructionMap.insert(std::pair<Value *, Value *>(Init, Init));
+  }
+}
