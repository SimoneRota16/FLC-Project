From: Simone Rota <simone.rota16@gmail.com>
Date: Thu, 29 Oct 2026 23:50:51 +0000
Subject: [PATCH 13/18] fix(REDDI): harden the _ret version of to_harden
 functions

FuncRetToRef replaces the calls to a function returning a value with calls to
its _ret version, which is not annotated: REDDI hardened the original function,
that is never called, and the program ran unprotected. The _ret version is
hardened too, and its calls from non-hardened functions are fixed.
In the functions that are not hardened, instructions are duplicated on demand
from the users of the hardened globals: when a local variable is duplicated,
the stores that write it are duplicated too, otherwise its copy is never
written (false data corruption).
---
 passes/EDDI.cpp | 35 +++++++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/passes/EDDI.cpp b/passes/EDDI.cpp
index 3d4229a..867aaf8 100755
--- a/passes/EDDI.cpp
+++ b/passes/EDDI.cpp
@@ -373,6 +373,11 @@ void EDDI::preprocess(Module &Md) {
         if(isa<Function>(x.first) && getFunctionDuplicate(cast<Function>(x.first)) == NULL) {
           // If is a function and it isn't/hasn't a duplicate version already
           toHardenFunctions.insert(cast<Function>(x.first));
+          // FuncRetToRef replaced the calls to a function returning a value
+          // with calls to its _ret version, that has to be hardened as well
+          if(Function *RetFn = Md.getFunction(x.first->getName().str() + "_ret")) {
+            toHardenFunctions.insert(RetFn);
+          }
         } else if(isa<Value>(x.first)) {
           toHardenVariables.insert(cast<Value>(x.first));
         }
@@ -1498,6 +1503,26 @@ int EDDI::duplicateInstruction(Instruction &I, BasicBlock &ErrBB) {
       
       clonedInst = cloneInstr(I);
 
+      // In a function that is not hardened (e.g. a function that just uses a
+      // hardened global variable) the instructions are duplicated on demand,
+      // starting from the users of the hardened globals: the stores that
+      // write the local variable have to be duplicated too, otherwise its
+      // copy would never be written.
+      if (CompiledFuncs.find(I.getFunction()) == CompiledFuncs.end()) {
+        std::vector<Instruction *> Writes;
+        for (User *U : I.users()) {
+          if (auto *SI = dyn_cast<StoreInst>(U); SI && SI->getPointerOperand() == &I) {
+            Writes.push_back(SI);
+          } else if (auto *MI = dyn_cast<MemIntrinsic>(U); MI && MI->getRawDest() == &I) {
+            Writes.push_back(MI);
+          }
+        }
+        for (Instruction *W : Writes) {
+          if (!isValueDuplicated(*W) && duplicateInstruction(*W, ErrBB)) {
+            InstructionsToRemove.insert(W);
+          }
+        }
+      }
     };
 
     
@@ -2040,8 +2065,14 @@ PreservedAnalyses EDDI::run(Module &Md, ModuleAnalysisManager &AM) {
       if(isa<Function>(annot.first)) {
         auto Fn = cast<Function>(annot.first);
         LLVM_DEBUG(dbgs() << "Adding to GrayAreaCallsToFix all calls of " << Fn->getName() << "\n");
-        // Get function calls in gray area
-        for(auto U : getFunctionFromDuplicate(Fn)->users()) {
+        // Get function calls in gray area, including the calls to the _ret
+        // version created by FuncRetToRef
+        std::vector<User *> FnUsers(getFunctionFromDuplicate(Fn)->users().begin(),
+                                    getFunctionFromDuplicate(Fn)->users().end());
+        if(Function *RetFn = Md.getFunction(getFunctionFromDuplicate(Fn)->getName().str() + "_ret")) {
+          FnUsers.insert(FnUsers.end(), RetFn->users().begin(), RetFn->users().end());
+        }
+        for(auto U : FnUsers) {
           if(isa<CallBase>(U)) {
             auto caller = cast<CallBase>(U)->getFunction();
             // Protect this call if it's not in toHardenFunction and is not marked as `exclude`
