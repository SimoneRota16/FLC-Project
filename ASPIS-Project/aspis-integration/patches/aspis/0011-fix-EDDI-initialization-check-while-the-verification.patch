From dac1433bee7caa10ae94794c54f1d043267cf30d Mon Sep 17 00:00:00 2001
From: Simone Rota <simone.rota16@gmail.com>
Date: Thu, 29 Oct 2026 23:49:22 +0000
Subject: [PATCH 11/19] fix(EDDI): initialization check while the verification
 block is built

isLocalValueInitializedBefore walks the CFG from the alloca looking for a
path to the checked instruction that does not store the variable. The walk also
enters the verification block being built, which has no terminator yet, and
concluded that the variable was initialized: the uninitialized return slot of a
call was compared (false data corruption, depending on the processing order).
Reaching the end of a block without terminator now means "not initialized".
---
 passes/EDDI.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/passes/EDDI.cpp b/passes/EDDI.cpp
index ce9a736..4a66f06 100755
--- a/passes/EDDI.cpp
+++ b/passes/EDDI.cpp
@@ -959,6 +959,12 @@ bool isLocalValueInitializedBefore(Instruction *AI, Instruction *At) {
       if(isa<StoreInst>(I) && storeInsts.find(cast<StoreInst>(I)) != storeInsts.end()) {
         break;
       }
+
+      // A block without terminator is the verification block being built for
+      // At, which will branch to At: the path reaches At without a store.
+      if(I->getNextNode() == nullptr && !I->isTerminator()) {
+        return false;
+      }
     } while(I = I->getNextNode());
   }
 
