From 5c6b53fd96a5da4128a02ee977f3d86c8d830299 Mon Sep 17 00:00:00 2001
From: Simone Rota <simone.rota16@gmail.com>
Date: Thu, 29 Oct 2026 23:46:24 +0000
Subject: [PATCH 07/18] fix(EDDI): duplicated memmove on shared memory

Intrinsics are always duplicated. When the destination of a memmove is not
duplicated (e.g. a heap buffer), the two copies of the call shift the data
twice and the program computes a wrong result. The duplicated memmove now
moves the destination onto itself when the two destinations are equal.
---
 passes/EDDI.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/passes/EDDI.cpp b/passes/EDDI.cpp
index d730d25..1eef661 100755
--- a/passes/EDDI.cpp
+++ b/passes/EDDI.cpp
@@ -15,6 +15,7 @@
 #include "llvm/IR/Function.h"
 #include "llvm/IR/IRBuilder.h"
 #include "llvm/IR/Instructions.h"
+#include "llvm/IR/IntrinsicInst.h"
 #include "llvm/IR/Metadata.h"
 #include "llvm/Pass.h"
 #include "llvm/Passes/PassBuilder.h"
@@ -1582,6 +1583,21 @@ int EDDI::duplicateInstruction(Instruction &I, BasicBlock &ErrBB) {
       // duplicate the operands
       duplicateOperands(I, ErrBB);
 
+      // memmove is not idempotent: when the two copies of the destination are
+      // the same memory (e.g. a heap buffer, which is not duplicated) the
+      // duplicated memmove would shift the data a second time. In that case
+      // it moves the destination onto itself, which leaves it unchanged.
+      if (auto *MoveDup = dyn_cast<MemMoveInst>(clonedInst)) {
+        auto *Move = cast<MemMoveInst>(CInstr);
+        IRBuilder<> MB(MoveDup);
+        Value *SameDest = MB.CreateICmpEQ(Move->getRawDest(), MoveDup->getRawDest());
+        Value *Source = MB.CreateSelect(SameDest, MoveDup->getRawDest(), MoveDup->getRawSource());
+        MoveDup->setSource(Source);
+        for (Value *V : {SameDest, Source}) {
+          DuplicatedInstructionMap.insert(std::pair<Value *, Value *>(V, V));
+        }
+      }
+
       if(isa<InvokeInst>(I)) {
         // In case of an invoke instruction, we have to fix the first invoke since 
         // it would jump to the next BB and not to the duplicated invoke instruction
