+
+// Removes the temporary duplicate Copy of Original created by
+// temporaryArgumentDuplication: it is a snapshot of the pointed value taken
+// right before a single call, so it cannot be used as duplicate elsewhere.
+void EDDI::removeTemporaryDuplicate(Value *Original, Value *Copy) {
+  for (auto [Key, Value] : {std::pair(Original, Copy), std::pair(Copy, Original)}) {
+    auto [Begin, End] = DuplicatedInstructionMap.equal_range(Key);
+    for (auto It = Begin; It != End; ++It) {
+      if (It->second == Value) {
+        DuplicatedInstructionMap.erase(It);
+        break;
+      }
+    }
+  }
 }
 
