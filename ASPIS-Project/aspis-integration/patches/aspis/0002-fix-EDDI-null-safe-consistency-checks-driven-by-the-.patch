+  if(!V1Ty->isPointerTT() || !V2Ty->isPointerTT() || !V1.getType()->isPointerTy() || !V2.getType()->isPointerTy()) {
+    errs() << "Warning: " << V1 << " or " << V2 << " is not a pointer\n";
