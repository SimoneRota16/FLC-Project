From f8ec381f0242d32753b0a6cd5be350e1b8c51b18 Mon Sep 17 00:00:00 2001
From: Simone Rota <simone.rota16@gmail.com>
Date: Thu, 29 Oct 2026 23:42:42 +0000
Subject: [PATCH 02/18] fix(EDDI): null-safe consistency checks driven by the
 LLVM type of the values

The consistency checks on pointers compare the pointed values, but
- a pointer can be null (e.g. the end of a linked list, or the argument of
  realloc): the check dereferenced it and the hardened program crashed. The
  loads now read from a zero-initialized constant when the pointer is null;
  if only one of the two copies is null the loaded values still differ;
- compareValues chose the comparison from the deduced (source-level) type, so a
  small struct passed as an i64 was handled with extractvalue on an integer and
  opt crashed; the comparison now depends on the LLVM type of the values;
- aggregates were "compared" by emitting extractvalue instructions that were
  never used (the elements are not in the deduced types), and the whole
  aggregate was loaded: only scalar values are compared now, since aggregates
  may contain uninitialized elements and padding.
---
 passes/ASPIS.h  |   2 +
 passes/EDDI.cpp | 132 +++++++++++++++++++++++-------------------------
 2 files changed, 66 insertions(+), 68 deletions(-)

diff --git a/passes/ASPIS.h b/passes/ASPIS.h
index 1d250c5..75e0ec8 100644
--- a/passes/ASPIS.h
+++ b/passes/ASPIS.h
@@ -55,6 +55,7 @@ class EDDI : public PassInfoMixin<EDDI> {
         bool MultipleErrBBEnabled;
         bool CoarseGrainedDuplicationEnabled;
         int comparisonCounter = 0;
+        std::map<Type *, GlobalVariable *> NullGuards;
 
         void preprocess(Module &Md);
         void fixDuplicatedConstructors(Module &Md);
@@ -64,6 +65,7 @@ class EDDI : public PassInfoMixin<EDDI> {
         void duplicateOperands (Instruction &I, BasicBlock &ErrBB);
         Value* getPtrFinalValue(Value &V);
         bool ptrNotDereferenceable(Value &V);
+        Value *getNullSafePointer(Value *Ptr, Type *Ty, IRBuilder<> &B);
         void comparePtrs(std::vector<Value *> *CmpInstructions, Value &V1, Value &V2, IRBuilder<> &B);
         void addConsistencyChecks(Instruction &I, BasicBlock &ErrBB);
         void fixFuncValsPassedByReference(Instruction &I, IRBuilder<> &B);
diff --git a/passes/EDDI.cpp b/passes/EDDI.cpp
index c0e861a..b5495e6 100755
--- a/passes/EDDI.cpp
+++ b/passes/EDDI.cpp
@@ -756,6 +756,20 @@ bool EDDI::ptrNotDereferenceable(Value &V) {
   return false;
 }
 
+// Returns a pointer from which a value of type Ty can be loaded safely: Ptr
+// itself or, if Ptr is null (e.g. the end of a linked list or the argument of
+// realloc), a zero-initialized constant. If only one of the two copies of a
+// pointer is null the loaded values differ, so the mismatch is still detected.
+Value *EDDI::getNullSafePointer(Value *Ptr, Type *Ty, IRBuilder<> &B) {
+  GlobalVariable *&Guard = NullGuards[Ty];
+  if (Guard == nullptr) {
+    Guard = new GlobalVariable(*B.GetInsertBlock()->getModule(), Ty, true,
+                               GlobalValue::PrivateLinkage,
+                               Constant::getNullValue(Ty), "aspis_null_guard");
+  }
+  return B.CreateSelect(B.CreateIsNull(Ptr), Guard, Ptr);
+}
+
 // Follows the pointers V1 and V2 using getPtrFinalValue() and adds a compare
 // instruction using the IRBuilder B.
 void EDDI::comparePtrs(std::vector<Value *> *CmpInstructions, Value &V1, Value &V2, IRBuilder<> &B) {
@@ -812,32 +826,40 @@ void EDDI::comparePtrs(std::vector<Value *> *CmpInstructions, Value &V1, Value &
     return;
   }
     
