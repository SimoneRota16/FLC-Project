-
-  while(V1Ty->isPointerTT()) {
-    V1Ty = V1Ty->getPointedType();
-
-    if(V1Ty == nullptr) {
-      errs() << "Warning1: Can't find final value for pointer " << V1 << "\n";
-      return;
-    }
-
-    if(F1->getType()->isPointerTy()) {
-      F1 = B.CreateLoad(V1Ty->getLLVMType(), F1);
