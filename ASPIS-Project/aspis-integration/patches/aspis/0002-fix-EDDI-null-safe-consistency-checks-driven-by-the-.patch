-      return;
+  // Follows the chain of pointers starting from V and returns the final
+  // (non-pointer) value, or nullptr if it cannot be loaded.
+  auto loadFinalValue = [&](Value *V, TransparentType *&VTy) -> Value * {
+    Value *F = V;
+    while(VTy->isPointerTT()) {
+      VTy = VTy->getPointedType();
+      if(VTy == nullptr || VTy->getLLVMType() == nullptr || !F->getType()->isPointerTy()) {
+        return nullptr;
+      }
+      Type *LoadTy = VTy->getLLVMType();
+      // Only scalar values are compared: an aggregate may contain
+      // uninitialized elements or padding, which differ between the copies.
+      if(!LoadTy->isPointerTy() && !LoadTy->isIntegerTy() && !LoadTy->isFloatingPointTy()) {
+        return nullptr;
+      }
+      F = B.CreateLoad(LoadTy, getNullSafePointer(F, LoadTy, B));
     }
+    return F;
+  };
 
-    if(F2->getType()->isPointerTy()) {
-      F2 = B.CreateLoad(V2Ty->getLLVMType(), F2);
-    }
+  F1 = loadFinalValue(F1, V1Ty);
+  if(F1 == nullptr) {
+    errs() << "Warning1: Can't find final value for pointer " << V1 << "\n";
+    return;
+  }
+  F2 = loadFinalValue(F2, V2Ty);
+  if(F2 == nullptr) {
+    errs() << "Warning2: Can't find final value for pointer " << V2 << "\n";
+    return;
   }
 
   if(F1->getType() != F2->getType()) {
@@ -1028,54 +1050,28 @@ void EDDI::compareValues(std::vector<Value *> *CmpInstructions, Value &V1, Value
     return;
   }
 
-  TransparentType *V1Ty = deducedTypes.transparentTypes.find(&V1)->second.begin()->get();
-  TransparentType *V2Ty = deducedTypes.transparentTypes.find(&V2)->second.begin()->get();
-
